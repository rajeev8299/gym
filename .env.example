# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (used for all site data, admin login, and uploaded images)
MONGODB_URI=

# Gmail account used to SEND password-reset emails (SMTP)
EMAIL_USER=

# Gmail "App Password" (NOT your normal Gmail password).
# How to generate:
# 1. Go to https://myaccount.google.com/security and enable "2-Step Verification" if not already on.
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password (name it e.g. "Bob's Gym Admin"), copy the 16-character code.
# 4. Paste it below with no spaces.
EMAIL_APP_PASSWORD=

# The email address that is allowed to request a password reset for the admin panel.
ADMIN_RECOVERY_EMAIL=

# Public base URL of the site, used to build the reset link sent in the email.
# For local testing this is fine as-is. Change it to your real domain once deployed.
BASE_URL=http://localhost:3000
